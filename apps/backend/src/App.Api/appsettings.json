{
  "Application": {
    "Name": "BetterBooking"
  },
  "Authentication": {
    "Authority": "",
    "Audience": ""
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RequestTimeouts": {
    "DefaultSeconds": 30
  },
  "RateLimiting": {
    "ReservationCreation": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*"
}
